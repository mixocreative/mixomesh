{
  "name": "mixomesh",
  "version": "0.3.0",
  "description": "Full-colour 3D print preparation (MIXOMESH)",
  "author": "mixocreative",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "install:deps": "node scripts/install-deps.mjs",
    "dev": "vite --host 127.0.0.1 --port 5173",
    "clean": "node scripts/clean.mjs",
    "prebuild": "node scripts/clean.mjs",
    "build": "vite build",
    "postbuild": "node scripts/build-notices.mjs",
    "notices": "node scripts/build-notices.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "pretest": "node -e \"require('node:fs').mkdirSync('.tmp',{recursive:true})\"",
    "test": "node --import ./tests/register-hooks.mjs --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=./tests/failures-reporter.mjs --test-reporter-destination=.tmp/last-test-failures.txt tests/*.test.mjs",
    "test:headless": "npm test",
    "test:all": "npm test && npm run test:browser && npm run test:export && npm run test:repair && npm run test:group && npm run test:ui-style && npm run test:refinement && npm run test:3mf-orientation && npm run test:settings-toggle && npm run test:outliner-hover && npm run test:boolean",
    "test:browser": "node tests/browser-smoke.mjs",
    "test:publish": "node tests/browser-publish-smoke.mjs",
    "test:export": "node tests/browser-export-smoke.mjs",
    "test:repair": "node tests/browser-repair-smoke.mjs",
    "test:group": "node tests/browser-group-repair-smoke.mjs",
    "test:ui-style": "node tests/browser-ui-style-smoke.mjs",
    "test:refinement": "node tests/browser-refinement-smoke.mjs",
    "test:3mf-orientation": "node tests/browser-3mf-orientation-c01.mjs",
    "test:settings-toggle": "node tests/browser-settings-toggle-d01.mjs",
    "test:outliner-hover": "node tests/browser-outliner-hover-w08.mjs",
    "test:boolean": "node tests/browser-boolean-smoke.mjs",
    "probe:scans": "node tests/scan-probe.mjs",
    "fixtures:heavy": "node scripts/heavy-mesh/generate.mjs",
    "perf:heavy": "node scripts/heavy-mesh/measure.mjs",
    "test:video": "node tests/browser-video-check.mjs",
    "test:webgpu": "node tests/browser-webgpu-check.mjs",
    "test:electron": "node tests/electron-smoke.mjs",
    "test:live-tunnel": "node tests/listbridge-live-tunnel.mjs",
    "test:rehearsal": "node tests/listbridge-rehearsal.mjs",
    "electron": "electron electron/main.cjs",
    "fetch:cloudflared": "node scripts/fetch-cloudflared.mjs",
    "predist": "npm run build",
    "dist": "electron-builder --win",
    "build:installer": "node scripts/build-installer.mjs",
    "smoke:packaged": "node scripts/packaged-smoke.mjs",
    "i18n:check": "node scripts/i18n-check.mjs",
    "fixtures": "node tests/fixtures/make-open-tetra.mjs && node tests/fixtures/make-textured-quad.mjs"
  },
  "dependencies": {
    "@babylonjs/core": "9.6.2",
    "@babylonjs/loaders": "9.6.2",
    "@babylonjs/materials": "9.6.2",
    "@babylonjs/serializers": "9.6.2",
    "@fontsource/zen-kaku-gothic-new": "^5.3.1",
    "jszip": "^3.10.1",
    "mp4-muxer": "^5.2.2",
    "saxes": "6.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@xmldom/xmldom": "0.8.15",
    "electron": "^43.2.0",
    "electron-builder": "26.15.3",
    "eslint": "^9.30.0",
    "globals": "^16.0.0",
    "typescript": "^6.0.0",
    "vite": "8.0.16"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
