{
  "compilerOptions": {
    "target": "ES2024",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "strict": true,
    "jsx": "react-jsx",
    "paths": {
      "@mixo-geocore/host/*": ["./vendor/mixo-geocore/host/*"],
      "@mixo-geocore/editing/*": ["./vendor/mixo-geocore/editing/*"],
      "@mixo-geocore/engine": ["./public/vendor/mixo-geometry/mixo_geometry_wasm.js"]
    },
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "vendor/mixo-geocore/**/*.ts", "vite.config.ts", "vitest.config.ts"]
}
